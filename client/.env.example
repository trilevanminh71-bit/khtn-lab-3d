# URL backend FastAPI (cổng mặc định của dự án: 8001).
# Chạy trên 1 máy: http://localhost:8001
# Mạng LAN lớp học: XÓA dòng này (để trống) — app tự dò http://<IP máy chủ hiện tại>:8001 cho mọi học sinh.
# Deploy Vercel: đặt URL Render, ví dụ https://khtn-lab-3d-api.onrender.com
VITE_API_URL=http://localhost:8001
# Link gói cập nhật bài học JSON (GitHub raw / Google Drive public). Để trống = tắt.
VITE_REMOTE_UPDATE_URL=
