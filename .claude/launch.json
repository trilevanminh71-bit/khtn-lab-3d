{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "khtn-client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "client",
        "run",
        "dev"
      ],
      "port": 5175,
      "autoPort": false
    },
    {
      "name": "khtn-server",
      "runtimeExecutable": "server/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--app-dir",
        "server",
        "--host",
        "0.0.0.0",
        "--port",
        "8001"
      ],
      "port": 8001,
      "autoPort": false
    }
  ]
}
