# Để trống = dùng SQLite cục bộ (server/local_lab.db) — phù hợp mạng LAN lớp học không Internet
# Neon PostgreSQL: postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/khtnlab?sslmode=require
DATABASE_URL=
# Khóa Gemini (Google AI Studio). Để trống = trợ lý AI dùng kho gợi mở offline
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Các origin được phép gọi API (phân cách bằng dấu phẩy). Mặc định đã cho phép localhost, IP LAN và *.vercel.app
CORS_ORIGINS=
# Mã truy cập quản trị cho /api/backup (GET). Đặt chuỗi bí mật khi deploy cloud
ADMIN_TOKEN=
