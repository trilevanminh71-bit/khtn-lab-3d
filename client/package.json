{
  "name": "khtn-lab-3d-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "KHTN-Lab 3D — Phòng thí nghiệm 3D ảo Vật lí, Hóa học, Sinh học Lớp 10 (Kết nối tri thức)",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
